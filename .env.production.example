# Copy to .env.production, keep it private, and supply real production values.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
PUBLIC_URL=https://outbox.example.com
WEB_PORT=8080
SESSION_SECRET=replace-with-a-random-64-character-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ACCOUNTS_JSON=
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

SMTP_SENDERS=sales@example.test,support@example.test

# Comma-separated account emails allowed to view/manage all BullMQ jobs.
QUEUE_ADMIN_EMAILS=
